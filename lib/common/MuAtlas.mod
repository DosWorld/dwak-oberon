(*
    The microui font atlas: a 128x128 8-bit alpha texture and the source
    rectangles into it - the four icons, one white pixel and 96 glyphs.

    Generated by tools/mkatlas.py from microui's demo/atlas.inl.
    Do not edit by hand: change the C file and run the script again.

    Oberon-07 here has no array constants and a string literal may not
    carry arbitrary bytes, so both tables travel as base64 text and are
    decoded into their arrays while the module is being loaded.  A chunk
    is a whole number of base64 groups: the decoder reads four characters
    at a time and the last group of a chunk is not continued into the
    next, so a chunk boundary is never in the middle of a group.
*)

MODULE MuAtlas;


CONST

    Width*  = 128;
    Height* = 128;
    Size*   = Width * Height;
    MaxRects* = 134;

    (* Where each table entry lives.  The icons are the values microui
       passes to DrawIcon; White is the single pixel a rectangle is filled
       with; the glyph of character c is at FontBase + c. *)
    IconClose*     = 1;
    IconCheck*     = 2;
    IconCollapsed* = 3;
    IconExpanded*  = 4;
    White*         = 5;
    FontBase*      = 6;

    (* The rectangles come last in the stream, four bytes each. *)
    RectAt = Size;
    RawSize = Size + MaxRects * 4;

    (* The stream, in chunks of a whole number of base64 groups. *)
    Chunk0 = "";

    Chunk1 = "";

    Chunk2 = "";

    Chunk3 = "";

    Chunk4 = "";

    Chunk5 = "";

    Chunk6 = "";

    Chunk7 = "";

    Chunk8 = "";

    Chunk9 = "";

    Chunk10 = "";

    Chunk11 = "";

    Chunk12 = "";

    Chunk13 = "";

    Chunk14 = "";

    Chunk15 = "";

    Chunk16 = "";

    Chunk17 = "";

    Chunk18 = "";

    Chunk19 = "";

    Chunk20 = "";

    Chunk21 = "";

    Chunk22 = "";

    Chunk23 = "";

    Chunk24 = "";

    Chunk25 = "";

    Chunk26 = "";

    Chunk27 = "";

    Chunk28 = "";

    Chunk29 = "";

    Chunk30 = "";

    Chunk31 = "";

    Chunk32 = "";

    Chunk33 = "";

    Chunk34 = "";

    Chunk35 = "";

    Chunk36 = "";

    Chunk37 = "";

    Chunk38 = "";

    Chunk39 = "";

    Chunk40 = "";

    Chunk41 = "";

    Chunk42 = "";

    Chunk43 = "";

    Chunk44 = "HjMGESQzBhFFRAMRfDMEEUhEAxEqMwYRD0QEETAzBhE2MwYRYREHEQA0BRFoEQcRPDMGERNEBBFCMwYRbxEHEUtEAxFORAMRSDMGEVFEAxEwAAoRdhEHEQASBxEHEgcRDiIHERdEBBEFNAURG0QEERUiBxFOMwYRXgAJEVQzBhFaMwYRCkQFER9EBBFgMwYRI0QEEWYzBhFsMwYR";


TYPE

    (* x, y, w, h - the source rectangle of one atlas entry. *)
    Rect* = ARRAY 4 OF INTEGER;


VAR

    Pixels*: ARRAY Size OF BYTE;      (* the alpha texture, row by row *)
    Rects*:  ARRAY MaxRects OF Rect;

    (* The decoded stream: the texture, then the rectangle table. *)
    Raw: ARRAY RawSize OF BYTE;

    pos, i, c: INTEGER;


(* Val - the value a base64 character stands for.  The alphabet is
   A-Z, a-z, 0-9, + and /, so the four ranges are read off the code and
   no table is needed. *)
PROCEDURE Val (ch: CHAR): INTEGER;
VAR
    v: INTEGER;

BEGIN
    v := ORD(ch);
    IF v >= ORD("a") THEN
        v := v - ORD("a") + 26
    ELSIF v >= ORD("A") THEN
        v := v - ORD("A")
    ELSIF v >= ORD("0") THEN
        v := v - ORD("0") + 52
    ELSIF ch = "+" THEN
        v := 62
    ELSE
        v := 63
    END;

    RETURN v
END Val;


(* Unpack - decode one chunk into Raw at the cursor.  Four characters carry
   three bytes, and the cursor is left at a group boundary. *)
PROCEDURE Unpack (src: ARRAY OF CHAR);
VAR
    i, a, b, c, d: INTEGER;

BEGIN
    i := 0;
    WHILE (i + 3 < LENGTH(src)) & (src[i] # 0X) DO
        a := Val(src[i]);     b := Val(src[i + 1]);
        c := Val(src[i + 2]); d := Val(src[i + 3]);
        IF pos < RawSize THEN Raw[pos] := a * 4 + b DIV 16 END;
        INC(pos);
        IF pos < RawSize THEN
            Raw[pos] := (b MOD 16) * 16 + c DIV 4
        END;
        INC(pos);
        IF pos < RawSize THEN
            Raw[pos] := (c MOD 4) * 64 + d
        END;
        INC(pos);
        INC(i, 4)
    END
END Unpack;


BEGIN
    pos := 0;
    Unpack(Chunk0);
    Unpack(Chunk1);
    Unpack(Chunk2);
    Unpack(Chunk3);
    Unpack(Chunk4);
    Unpack(Chunk5);
    Unpack(Chunk6);
    Unpack(Chunk7);
    Unpack(Chunk8);
    Unpack(Chunk9);
    Unpack(Chunk10);
    Unpack(Chunk11);
    Unpack(Chunk12);
    Unpack(Chunk13);
    Unpack(Chunk14);
    Unpack(Chunk15);
    Unpack(Chunk16);
    Unpack(Chunk17);
    Unpack(Chunk18);
    Unpack(Chunk19);
    Unpack(Chunk20);
    Unpack(Chunk21);
    Unpack(Chunk22);
    Unpack(Chunk23);
    Unpack(Chunk24);
    Unpack(Chunk25);
    Unpack(Chunk26);
    Unpack(Chunk27);
    Unpack(Chunk28);
    Unpack(Chunk29);
    Unpack(Chunk30);
    Unpack(Chunk31);
    Unpack(Chunk32);
    Unpack(Chunk33);
    Unpack(Chunk34);
    Unpack(Chunk35);
    Unpack(Chunk36);
    Unpack(Chunk37);
    Unpack(Chunk38);
    Unpack(Chunk39);
    Unpack(Chunk40);
    Unpack(Chunk41);
    Unpack(Chunk42);
    Unpack(Chunk43);
    Unpack(Chunk44);

    FOR i := 0 TO Size - 1 DO
        Pixels[i] := Raw[i]
    END;

    (* The rectangle table is four bytes - x, y, w and h - per entry. *)
    FOR i := 0 TO MaxRects - 1 DO
        FOR c := 0 TO 3 DO
            Rects[i][c] := Raw[RectAt + i * 4 + c]
        END
    END

END MuAtlas.
