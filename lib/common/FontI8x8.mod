(*
    Public domain (The Unlicense)

    Copyright (c) 2026-, DosWorld
    All rights reserved.

    FontI8x8 - 749 glyphs, cell 8x8, baseline 7 rows down.

    Generated by samples/microui/Pcf2Mod.mod from IBM CGA 8x8.
    Do not edit by hand: change the font and run the program again.

    The font is compiled in, so a program that imports this needs
    no file beside it.  lib/common/FontFile.mod hands these
    three tables to the same store a .pcf, .bdf, .hex or .psf is
    read into, so nothing in the renderer knows which it got.

    Oberon-07 here has no array constants and a string literal may
    not carry arbitrary bytes, so the tables travel as base64 text
    and are decoded into their arrays while the module is being
    loaded.  A chunk is a whole number of base64 groups: the
    decoder reads four characters at a time and the last group of
    a chunk is not continued into the next, so a chunk boundary
    is never in the middle of a group.

    The two streams are the index and the ink.  The index is the
    code points, two bytes each and ascending, followed by the
    four ink-box numbers a glyph - left and right side bearing,
    ascent and descent - each a 16-bit number biased by 32768 and
    so read back by subtracting it.  The ink stream is the
    bitmaps: one bit to a pixel, each glyph's rows packed to
    (w + 7) DIV 8 bytes, the glyphs one after another in the
    order the code points give them.
*)

MODULE FontI8x8;


CONST

    (* The font, as a program that lists fonts wants it said. *)
    NameMax = 32;
    Count* = 749;
    CellW* = 8;
    CellH* = 8;
    Ascent* = 7;

    BoxN = Count * 4;
    IdxN = Count * 2 + BoxN * 2;
    BitsN = 4693;

    (* The index stream, then the ink stream. *)
    IdxChunk0   = "";
    IdxChunk1   = "";
    IdxChunk2   = "";
    IdxChunk3   = "";
    IdxChunk4   = "";
    IdxChunk5   = "";
    IdxChunk6   = "";
    IdxChunk7   = "";
    IdxChunk8   = "";
    IdxChunk9   = "";
    IdxChunk10  = "";
    IdxChunk11  = "";
    IdxChunk12  = "";
    IdxChunk13  = "";
    IdxChunk14  = "";
    IdxChunk15  = "";
    IdxChunk16  = "";
    IdxChunk17  = "";
    IdxChunk18  = "";
    IdxChunk19  = "";

    BitChunk0   = "";
    BitChunk1   = "";
    BitChunk2   = "";
    BitChunk3   = "";
    BitChunk4   = "";
    BitChunk5   = "";
    BitChunk6   = "";
    BitChunk7   = "";
    BitChunk8   = "";
    BitChunk9   = "";
    BitChunk10  = "";
    BitChunk11  = "";
    BitChunk12  = "/3DY2HB+gaWBvZmBfn7/2//D5/9+GNs85+c82xh4zMzMeDD8MA8HD33MzMx4EBA4fP58EDg4fDj+/tYQOGz+/v58OBAQOHz+fDgQPzM/MDBw8OB/Y39jY2fmwAMDBgbGbDwYPm5g/mZm9z5mZvZmZvfDmfnz5//n/w==";


VAR

    (* The name is a variable and not a CONST string because a
       string constant cannot be indexed here - `CONST D = "0123";
       D[1]` is "not an array" - and a caller that wants to copy
       the name into a field of its own has to read it one
       character at a time. *)
    Name*: ARRAY NameMax OF CHAR;

    (* The code points of the glyphs, ascending.  Ascending is a
       promise: FontFile.Find is a binary search. *)
    Codes*: ARRAY Count OF INTEGER;

    (* Four numbers a glyph, in the order Codes gives them: the
       left side bearing, the right side bearing, the ascent and
       the descent.  The ink is `rsb - lsb` wide and `asc + desc`
       tall, and it is drawn at `(lsb, Ascent - asc)`. *)
    Box*: ARRAY BoxN OF INTEGER;

    (* The ink itself, one bit to a pixel, bit 7 the leftmost. *)
    Bits*: ARRAY BitsN OF BYTE;

    Idx: ARRAY IdxN OF BYTE;
    pos, k: INTEGER;


(* Val - one base64 character as six bits.  The alphabet is ordered
   A-Z, a-z, 0-9, + and /, so the four ranges are read off the code
   and no table is needed. *)
PROCEDURE Val (ch: CHAR): INTEGER;
VAR
    v: INTEGER;

BEGIN
    v := ORD(ch);
    IF v >= ORD("a") THEN
        v := v - ORD("a") + 26
    ELSIF v >= ORD("A") THEN
        v := v - ORD("A")
    ELSIF v >= ORD("0") THEN
        v := v - ORD("0") + 52
    ELSIF ch = "+" THEN
        v := 62
    ELSE
        v := 63
    END;

    RETURN v
END Val;


(* Unpack - decode one chunk into `dst` at the cursor.  Four
   characters carry three bytes, and the cursor is left at a group
   boundary, so the caller can keep it across chunks. *)
PROCEDURE Unpack (src: ARRAY OF CHAR; VAR dst: ARRAY OF BYTE;
                   VAR pos: INTEGER);
VAR
    i, a, b, c, d, n: INTEGER;

BEGIN
    n := LEN(dst);
    i := 0;
    WHILE (i + 3 < LENGTH(src)) & (src[i] # 0X) DO
        a := Val(src[i]);     b := Val(src[i + 1]);
        c := Val(src[i + 2]); d := Val(src[i + 3]);
        IF pos < n THEN dst[pos] := a * 4 + b DIV 16 END;
        INC(pos);
        IF pos < n THEN dst[pos] := (b MOD 16) * 16 + c DIV 4 END;
        INC(pos);
        IF pos < n THEN dst[pos] := (c MOD 4) * 64 + d END;
        INC(pos);
        INC(i, 4)
    END
END Unpack;


BEGIN
    Name := "IBM CGA 8x8";

    pos := 0;
    Unpack(IdxChunk0, Idx, pos);
    Unpack(IdxChunk1, Idx, pos);
    Unpack(IdxChunk2, Idx, pos);
    Unpack(IdxChunk3, Idx, pos);
    Unpack(IdxChunk4, Idx, pos);
    Unpack(IdxChunk5, Idx, pos);
    Unpack(IdxChunk6, Idx, pos);
    Unpack(IdxChunk7, Idx, pos);
    Unpack(IdxChunk8, Idx, pos);
    Unpack(IdxChunk9, Idx, pos);
    Unpack(IdxChunk10, Idx, pos);
    Unpack(IdxChunk11, Idx, pos);
    Unpack(IdxChunk12, Idx, pos);
    Unpack(IdxChunk13, Idx, pos);
    Unpack(IdxChunk14, Idx, pos);
    Unpack(IdxChunk15, Idx, pos);
    Unpack(IdxChunk16, Idx, pos);
    Unpack(IdxChunk17, Idx, pos);
    Unpack(IdxChunk18, Idx, pos);
    Unpack(IdxChunk19, Idx, pos);

    pos := 0;
    Unpack(BitChunk0, Bits, pos);
    Unpack(BitChunk1, Bits, pos);
    Unpack(BitChunk2, Bits, pos);
    Unpack(BitChunk3, Bits, pos);
    Unpack(BitChunk4, Bits, pos);
    Unpack(BitChunk5, Bits, pos);
    Unpack(BitChunk6, Bits, pos);
    Unpack(BitChunk7, Bits, pos);
    Unpack(BitChunk8, Bits, pos);
    Unpack(BitChunk9, Bits, pos);
    Unpack(BitChunk10, Bits, pos);
    Unpack(BitChunk11, Bits, pos);
    Unpack(BitChunk12, Bits, pos);

    FOR k := 0 TO Count - 1 DO
        Codes[k] := Idx[k * 2] * 100H + Idx[k * 2 + 1]
    END;

    (* The box numbers are biased by 8000H on the way out, so what
       they are read back with is a subtraction, and a negative
       bearing arrives as the negative number it was. *)
    FOR k := 0 TO BoxN - 1 DO
        Box[k] := (Idx[Count * 2 + k * 2] * 100H +
                   Idx[Count * 2 + k * 2 + 1]) - 8000H
    END

END FontI8x8.
